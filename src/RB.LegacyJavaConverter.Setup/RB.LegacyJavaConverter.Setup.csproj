<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RMCodexMCConverter-Setup</AssemblyName>
    <RootNamespace>RB.LegacyJavaConverter.Setup</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Product>RMCodexMCConverter Setup</Product>
    <Company>RobbieB1980</Company>
    <Version>2.10.14</Version>
    <FileVersion>2.10.14</FileVersion>
    <InformationalVersion>2.10.14</InformationalVersion>
    <Description>Installer for RMCodexMCConverter (portable toolset)</Description>
    <PayloadZip Condition="'$(PayloadZip)' == ''">..\..\dist\portable-payload.zip</PayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)"
                      Condition="Exists('$(PayloadZip)')"
                      LogicalName="portable-payload.zip" />
  </ItemGroup>

</Project>
